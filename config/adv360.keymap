#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_workman_layer {
            display-name = "Base";
            bindings = <
&kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL  &kp ASTERISK  &kp ESCAPE                                                                                        &kp AT_SIGN    &kp GRAVE  &kp HASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp DOLLAR
&kp COLON       &kp Q            &kp D             &kp R              &kp W      &kp B         &kp TAB                                                                                           &kp PERCENT    &kp J      &kp F     &kp U                 &kp P                  &kp SEMICOLON      &kp SINGLE_QUOTE
&kp UNDERSCORE  &kp A            &kp S             &kp H              &kp T      &kp G         &kp LEFT_CONTROL  &kp LEFT_ALT          &mo 1            &kp F7               &kp F8              &kp AMPERSAND  &kp Y      &kp N     &kp E                 &kp O                  &kp I              &kp MINUS
&kp PIPE        &kp Z            &kp X             &kp M              &kp C      &kp V                                                 &kp DELETE       &kp F6                                                  &kp K      &kp L     &kp COMMA             &kp DOT                &kp FSLH           &kp BACKSLASH
&kp PAGE_UP     &kp F1           &kp F2            &kp F3             &kp F4                   &kp LEFT_GUI      &mt LEFT_SHIFT ENTER  &lt 1 ENTER      &mt LEFT_CONTROL F5  &mt LEFT_ALT ENTER  &kp SPACE                 &kp F9    &kp F10               &kp F11                &kp F12            &kp EXCLAMATION
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F23    &kp F1     &kp F2           &kp F3         &kp F4   &kp F5  &kp F6                                                                     &kp F7          &kp F8    &kp F9        &kp F10       &kp F11         &kp F12            &kp MINUS
&kp TAB    &kp Q      &kp W            &kp E          &kp R    &kp T   &none                                                                      &none           &kp Y     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&kp ESC    &kp A      &kp S            &kp BACKSPACE  &kp DEL  &kp G   &to 2         &kp LEFT_ALT    &none                 &bt BT_NXT  &kp RCTRL  &studio_unlock  &kp HOME  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6    &kp KP_PLUS        &kp SQT
&kp LSHFT  &kp Z      &kp X            &kp C          &kp V    &kp B                                 &kp HOME              &kp PG_UP                              &kp END   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp UP_ARROW       &kp C_BRIGHTNESS_INC
&mo 0      &kp GRAVE  &kp PAUSE_BREAK  &none          &none            &kp LEFT_GUI  &kp LEFT_SHIFT  &kp LEFT_CONTROL      &kp PG_DN   &kp ENTER  &kp KP_N0                 &kp NUMBER_0  &none         &kp LEFT_ARROW  &kp DOWN_ARROW     &kp RIGHT
            >;
        };

        QWERTY {
            display-name = "QWERTY";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &none                                                                          &trans     &kp N6  &kp N7      &kp N8      &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &to 1                                                                          &to 0      &kp Y   &kp U       &kp I       &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &to 0     &kp LEFT_CONTROL  &kp LEFT_ALT      &kp LEFT_GUI   &kp LEFT_CONTROL  &to 0      &kp H   &kp J       &kp K       &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                               &kp HOME          &kp PAGE_UP                                 &kp N   &kp M       &kp COMMA   &kp DOT   &kp FSLH  &kp RSHFT
&none      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DELETE        &kp END           &kp PAGE_DOWN  &kp ENTER         &kp SPACE          &bl BL_INC  &bl BL_DEC  &kp LBKT  &kp RBKT  &to 0
            >;
        };
    };
};
