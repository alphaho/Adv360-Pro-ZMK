#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_workman_layer {
            display-name = "Base";
            bindings = <
&kp LEFT_BRACE  &kp RIGHT_BRACE   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EQUAL       &kp ASTERISK  &kp ESCAPE                                                                          &mo 3      &kp GRAVE  &kp HASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DOUBLE_QUOTES  &kp DOLLAR
&kp COLON       &kp Q             &kp D             &kp R              &kp W           &kp B         &kp TAB                                                                             &none      &kp J      &kp F     &kp U                 &kp P                  &kp SEMICOLON      &kp SINGLE_QUOTE
&kp UNDERSCORE  &kp A             &kp S             &kp H              &kp T           &kp G         &kp LEFT_CONTROL  &kp K_CONTEXT_MENU  &kp LALT                &kp LGUI   &kp RCTRL  &none      &kp Y      &kp N     &kp E                 &kp O                  &kp I              &kp MINUS
&kp PIPE        &kp Z             &kp X             &kp M              &kp C           &kp V                                               &kp HOME                &kp PG_UP                        &kp K      &kp L     &kp COMMA             &kp DOT                &kp FSLH           &kp BACKSLASH
&mo 2           &kp LEFT_COMMAND  &kp LEFT_ALT      &to 1              &kp LEFT_SHIFT                &kp LEFT_GUI      &kp ENTER           &kp K_CONTEXT_MENU      &kp PG_DN  &kp ENTER  &kp SPACE             &kp UP    &kp DOWN              &kp LBKT               &kp RBKT           &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp F23    &kp F1     &kp F2           &kp F3         &kp F4     &kp F5  &kp F6                                                   &kp F7     &kp F8    &kp F9        &kp F10       &kp F11       &kp F12               &kp MINUS
&kp TAB    &kp Q      &kp W            &kp E          &kp R      &kp T   &none                                                    &none      &kp Y     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_MINUS          &kp BSLH
&kp ESC    &kp A      &kp S            &kp BACKSPACE  &kp DEL    &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp HOME  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_PLUS           &kp SQT
&kp LSHFT  &kp Z      &kp X            &kp C          &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp END   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC
&mo 2      &kp GRAVE  &kp PAUSE_BREAK  &kp LEFT       &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0            &kp NUMBER_0  &kp DOWN      &kp KP_DOT    &kp C_VOLUME_DOWN     &kp C_VOLUME_UP
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
